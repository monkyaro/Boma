{
  "realm": "boma",
  "enabled": true,
  "displayName": "BOMA",
  "loginTheme": "boma",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "verifyEmail": true,
  "sslRequired": "all",
  "roles": {
    "realm": [
      {
        "name": "owner"
      },
      {
        "name": "buyer"
      },
      {
        "name": "tenant"
      },
      {
        "name": "guest"
      },
      {
        "name": "officer"
      },
      {
        "name": "regional_supervisor"
      },
      {
        "name": "national_admin"
      },
      {
        "name": "finance"
      },
      {
        "name": "support"
      }
    ]
  },
  "clients": [
    {
      "clientId": "boma-web",
      "baseUrl": "https://bomahoop.com/",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://bomahoop.com/*",
        "https://www.bomahoop.com/*",
        "https://admin.bomahoop.com/*"
      ],
      "webOrigins": [
        "https://bomahoop.com",
        "https://www.bomahoop.com",
        "https://admin.bomahoop.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "boma-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "boma-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "authentication-method-reference",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "boma-mobile",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "boma://auth"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "boma-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "boma-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "authentication-method-reference",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultRoles": [
    "buyer"
  ]
}
