# Copy to .env for local development. Production values come from SSM Parameter Store.
SECRET_KEY=change-me
FLASK_DEBUG=true
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://boma:boma@postgres:5432/boma
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
KEYCLOAK_ISSUER=https://auth.bomahoop.com/realms/boma
KEYCLOAK_AUDIENCE=boma-api
KEYCLOAK_REALM=boma
# Staff provisioning (infrastructure/scripts/keycloak-admin-api-client.sh); empty disables it
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_ADMIN_CLIENT_ID=boma-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=
STAFF_SETUP_CLIENT_ID=boma-web
STAFF_SETUP_REDIRECT_URL=http://localhost:3000/dashboard
# false on test environments only: staff sign in with password alone
STAFF_MFA_REQUIRED=true
CORS_ORIGINS=http://localhost:3000
SWAGGER_UI_ENABLED=true
SWAGGER_USERNAME=boma
SWAGGER_PASSWORD=change-me
AWS_REGION=eu-west-1
AWS_S3_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com
MEDIA_S3_BUCKET=
SENTRY_DSN=

VIEWING_POLICY_APPROVED=false
VERIFICATION_INQUIRY_THRESHOLD=0
MEDIA_UPLOADS_ENABLED=false
KEYCLOAK_JWKS_URL=
API_WRITE_RATE_PER_MINUTE=60
PAYMENT_SANDBOX_ENABLED=false
# Set PAYMENT_SANDBOX_SIGNING_SECRET through secure runtime configuration when enabling the sandbox.
PAYMENT_SANDBOX_SIGNING_SECRET=
